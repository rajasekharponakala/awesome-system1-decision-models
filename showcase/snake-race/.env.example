# Copy to .env (git-ignored) and fill in. Real environment variables win.

# Jev (TypeSafe). Create a key in the TypeSafe console.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai

# Laya, served locally by its own Jev-compatible server (recommended):
#   pip install "laya[serve]" && laya-serve      # listens on 0.0.0.0:8000
LAYA_BASE_URL=http://127.0.0.1:8000
# Checkpoint: english, multilingual or typed-decisions
LAYA_MODEL=english
#
# Or via System One Runtime (https://github.com/LiteVar/system-one), port 8080,
# LAYA_MODEL=laya-multilingual. On Linux it needs the llama.cpp workaround in
# .github/workflows/snake-race-bench.yml.

# Any other Jev-compatible server (Von, OpenJev, ...) can replace either lane:
# point JEV_BASE_URL or LAYA_BASE_URL at it and set the model name.

# PORT=5173
# DECISION_TIMEOUT_MS=10000
# MOCK=1        # also add the two offline mock lanes
